{
  "profile_id": "part_design",
  "display_name": "Part Design",
  "auto_activate": { "trigger": "catia_workbench_id", "match": "PrtCfg" },
  "bindings": [
    {
      "id": "pd.touchpad_tap.select",
      "input": { "device": "ds4", "control": "touchpad_tap" },
      "target": { "type": "mouse_button", "button": "left" }
    },
    {
      "id": "pd.touchpad_swipe.pan",
      "input": { "device": "ds4", "control": "touchpad_swipe" },
      "target": { "type": "mouse_move", "axis": "both" },
      "analog": { "deadzone": 0.08, "sensitivity": 1.2, "curve": "linear" }
    },
    {
      "id": "pd.touchpad_click.rmb_context",
      "input": { "device": "ds4", "control": "touchpad_click" },
      "target": { "type": "mouse_button", "button": "right" }
    },
    {
      "id": "pd.cross.sketch",
      "input": { "device": "ds4", "control": "cross" },
      "target": { "type": "catia_command", "command_id": "Sketcher.NewSketch" }
    },
    {
      "id": "pd.square.pad",
      "input": { "device": "ds4", "control": "square" },
      "target": { "type": "catia_command", "command_id": "PartDesign.Pad" }
    },
    {
      "id": "pd.circle.pocket",
      "input": { "device": "ds4", "control": "circle" },
      "target": { "type": "catia_command", "command_id": "PartDesign.Pocket" }
    },
    {
      "id": "pd.triangle.exit_workbench_object",
      "input": { "device": "ds4", "control": "triangle" },
      "target": { "type": "catia_command", "command_id": "PartDesign.ExitWorkbenchObject" }
    },
    {
      "id": "pd.r1.fillet",
      "input": { "device": "ds4", "control": "r1" },
      "target": { "type": "catia_command", "command_id": "PartDesign.EdgeFillet" }
    },
    {
      "id": "pd.r2_digital.update",
      "input": { "device": "ds4", "control": "r2_digital" },
      "target": { "type": "catia_command", "command_id": "Edit.Update" }
    },
    {
      "id": "pd.share.undo",
      "input": { "device": "ds4", "control": "share" },
      "target": { "type": "catia_command", "command_id": "Edit.Undo" }
    },
    {
      "id": "pd.options.pause",
      "input": { "device": "ds4", "control": "options" },
      "target": { "type": "app_control", "action": "pause" }
    },
    {
      "id": "pd.ps.resume",
      "input": { "device": "ds4", "control": "ps" },
      "target": { "type": "app_control", "action": "resume" }
    },
    {
      "id": "pd.left_stick.orbit",
      "input": { "device": "ds4", "control": "left_stick" },
      "target": { "type": "catia_camera", "operation": "rotate" },
      "analog": { "deadzone": 0.15, "sensitivity": 1.0, "curve": "ease_out_quad" }
    },
    {
      "id": "pd.right_stick.pan",
      "input": { "device": "ds4", "control": "right_stick" },
      "target": { "type": "catia_camera", "operation": "translate" },
      "analog": { "deadzone": 0.12, "sensitivity": 1.0, "curve": "linear" }
    },
    {
      "id": "pd.l2.zoom_out",
      "input": { "device": "ds4", "control": "l2" },
      "target": { "type": "catia_camera", "operation": "zoom", "axis": [0.0, 0.0, -1.0] },
      "analog": { "deadzone": 0.05, "sensitivity": 1.0, "curve": "quadratic" }
    },
    {
      "id": "pd.r2.zoom_in",
      "input": { "device": "ds4", "control": "r2" },
      "target": { "type": "catia_camera", "operation": "zoom", "axis": [0.0, 0.0, 1.0] },
      "analog": { "deadzone": 0.05, "sensitivity": 1.0, "curve": "quadratic" }
    },
    {
      "id": "pd.l1.enter_constraint_layer",
      "input": { "device": "ds4", "control": "l1" },
      "target": { "type": "layer_control", "layer_id": "pd.l1-sketch-tools", "mode": "hold" }
    }
  ],
  "layers": [
    {
      "layer_id": "pd.l1-sketch-tools",
      "activation": {
        "trigger": { "device": "ds4", "control": "l1" },
        "mode": "hold"
      },
      "clears_on_profile_switch": true,
      "overrides": [
        {
          "id": "pd.l1.cross.constraint_coincident",
          "input": { "device": "ds4", "control": "cross" },
          "target": { "type": "catia_command", "command_id": "Sketcher.Constraint.Coincident" }
        },
        {
          "id": "pd.l1.square.constraint_distance",
          "input": { "device": "ds4", "control": "square" },
          "target": { "type": "catia_command", "command_id": "Sketcher.Constraint.Distance" }
        },
        {
          "id": "pd.l1.circle.exit_sketch",
          "input": { "device": "ds4", "control": "circle" },
          "target": { "type": "catia_command", "command_id": "Sketcher.ExitWorkbench" }
        }
      ]
    }
  ]
}
