{
  "profile_id": "drafting",
  "display_name": "Drafting",
  "auto_activate": { "trigger": "catia_workbench_id", "match": "CfgCfg" },
  "bindings": [
    {
      "id": "dft.touchpad_tap.select",
      "input": { "device": "ds4", "control": "touchpad_tap" },
      "target": { "type": "mouse_button", "button": "left" }
    },
    {
      "id": "dft.touchpad_swipe.pan_sheet",
      "input": { "device": "ds4", "control": "touchpad_swipe" },
      "target": { "type": "mouse_move", "axis": "both" },
      "analog": { "deadzone": 0.08, "sensitivity": 1.1, "curve": "linear" }
    },
    {
      "id": "dft.cross.dimension",
      "input": { "device": "ds4", "control": "cross" },
      "target": { "type": "catia_command", "command_id": "Drafting.Dimension" }
    },
    {
      "id": "dft.square.text",
      "input": { "device": "ds4", "control": "square" },
      "target": { "type": "catia_command", "command_id": "Drafting.Text" }
    },
    {
      "id": "dft.circle.callout",
      "input": { "device": "ds4", "control": "circle" },
      "target": { "type": "catia_command", "command_id": "Drafting.Callout" }
    },
    {
      "id": "dft.triangle.new_view",
      "input": { "device": "ds4", "control": "triangle" },
      "target": { "type": "catia_command", "command_id": "Drafting.FrontView" }
    },
    {
      "id": "dft.r1.new_sheet",
      "input": { "device": "ds4", "control": "r1" },
      "target": { "type": "catia_command", "command_id": "Drafting.NewSheet" }
    },
    {
      "id": "dft.r2_digital.update",
      "input": { "device": "ds4", "control": "r2_digital" },
      "target": { "type": "catia_command", "command_id": "Edit.Update" }
    },
    {
      "id": "dft.share.undo",
      "input": { "device": "ds4", "control": "share" },
      "target": { "type": "catia_command", "command_id": "Edit.Undo" }
    },
    {
      "id": "dft.options.pause",
      "input": { "device": "ds4", "control": "options" },
      "target": { "type": "app_control", "action": "pause" }
    },
    {
      "id": "dft.ps.resume",
      "input": { "device": "ds4", "control": "ps" },
      "target": { "type": "app_control", "action": "resume" }
    },
    {
      "id": "dft.right_stick.pan_sheet",
      "input": { "device": "ds4", "control": "right_stick" },
      "target": { "type": "catia_camera", "operation": "translate" },
      "analog": { "deadzone": 0.12, "sensitivity": 1.0, "curve": "linear" }
    },
    {
      "id": "dft.l2.zoom_out",
      "input": { "device": "ds4", "control": "l2" },
      "target": { "type": "catia_camera", "operation": "zoom", "axis": [0.0, 0.0, -1.0] },
      "analog": { "deadzone": 0.05, "sensitivity": 1.0, "curve": "quadratic" }
    },
    {
      "id": "dft.r2.zoom_in",
      "input": { "device": "ds4", "control": "r2" },
      "target": { "type": "catia_camera", "operation": "zoom", "axis": [0.0, 0.0, 1.0] },
      "analog": { "deadzone": 0.05, "sensitivity": 1.0, "curve": "quadratic" }
    },
    {
      "id": "dft.l1.enter_annotation_layer",
      "input": { "device": "ds4", "control": "l1" },
      "target": { "type": "layer_control", "layer_id": "dft.l1-annotation", "mode": "hold" }
    }
  ],
  "layers": [
    {
      "layer_id": "dft.l1-annotation",
      "activation": {
        "trigger": { "device": "ds4", "control": "l1" },
        "mode": "hold"
      },
      "clears_on_profile_switch": true,
      "overrides": [
        {
          "id": "dft.l1.cross.leader_line",
          "input": { "device": "ds4", "control": "cross" },
          "target": { "type": "catia_command", "command_id": "Drafting.LeaderLine" }
        },
        {
          "id": "dft.l1.square.datum_target",
          "input": { "device": "ds4", "control": "square" },
          "target": { "type": "catia_command", "command_id": "Drafting.DatumTarget" }
        },
        {
          "id": "dft.l1.circle.geometrical_tolerance",
          "input": { "device": "ds4", "control": "circle" },
          "target": { "type": "catia_command", "command_id": "Drafting.GeometricalTolerance" }
        }
      ]
    }
  ]
}
