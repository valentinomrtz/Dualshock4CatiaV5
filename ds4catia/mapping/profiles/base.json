{
  "profile_id": "base",
  "display_name": "Base / Global",
  "auto_activate": null,
  "bindings": [
    {
      "id": "base.dpad.standard_views",
      "input": { "device": "ds4", "control": "dpad" },
      "target": { "type": "catia_command", "command_id": "View.NamedViews" }
    },
    {
      "id": "base.triangle.iso_view",
      "input": { "device": "ds4", "control": "triangle" },
      "target": { "type": "catia_command", "command_id": "View.Isometric" }
    },
    {
      "id": "base.square.fit_all",
      "input": { "device": "ds4", "control": "square" },
      "target": { "type": "catia_command", "command_id": "View.FitAll" }
    },
    {
      "id": "base.circle.normal_view",
      "input": { "device": "ds4", "control": "circle" },
      "target": { "type": "catia_command", "command_id": "View.NormalView" }
    },
    {
      "id": "base.cross.select",
      "input": { "device": "ds4", "control": "cross" },
      "target": { "type": "mouse_button", "button": "left" },
      "digital": { "tap_ms": 150, "hold_ms": 350 }
    },
    {
      "id": "base.left_stick.orbit",
      "input": { "device": "ds4", "control": "left_stick" },
      "target": { "type": "catia_camera", "operation": "rotate" },
      "analog": { "deadzone": 0.15, "sensitivity": 1.0, "curve": "ease_out_quad" }
    },
    {
      "id": "base.right_stick.pan",
      "input": { "device": "ds4", "control": "right_stick" },
      "target": { "type": "catia_camera", "operation": "translate" },
      "analog": { "deadzone": 0.12, "sensitivity": 1.0, "curve": "linear" }
    },
    {
      "id": "base.l2.zoom_out",
      "input": { "device": "ds4", "control": "l2" },
      "target": { "type": "catia_camera", "operation": "zoom", "axis": [0.0, 0.0, -1.0] },
      "analog": { "deadzone": 0.05, "sensitivity": 1.0, "curve": "quadratic" }
    },
    {
      "id": "base.r2.zoom_in",
      "input": { "device": "ds4", "control": "r2" },
      "target": { "type": "catia_camera", "operation": "zoom", "axis": [0.0, 0.0, 1.0] },
      "analog": { "deadzone": 0.05, "sensitivity": 1.0, "curve": "quadratic" }
    },
    {
      "id": "base.r1.mouse_right",
      "input": { "device": "ds4", "control": "r1" },
      "target": { "type": "mouse_button", "button": "right" }
    },
    {
      "id": "base.l1.enter_shift_layer",
      "input": { "device": "ds4", "control": "l1" },
      "target": { "type": "layer_control", "layer_id": "base.l1-shift", "mode": "hold" }
    },
    {
      "id": "base.options.pause_resume",
      "input": { "device": "ds4", "control": "options" },
      "target": { "type": "app_control", "action": "pause" }
    },
    {
      "id": "base.ps.resume",
      "input": { "device": "ds4", "control": "ps" },
      "target": { "type": "app_control", "action": "resume" }
    },
    {
      "id": "base.share.next_profile",
      "input": { "device": "ds4", "control": "share" },
      "target": { "type": "app_control", "action": "next_profile" }
    },
    {
      "id": "base.touchpad_tap.clear_selection",
      "input": { "device": "ds4", "control": "touchpad_tap" },
      "target": { "type": "catia_selection", "operation": "clear" }
    }
  ],
  "layers": [
    {
      "layer_id": "base.l1-shift",
      "activation": {
        "trigger": { "device": "ds4", "control": "l1" },
        "mode": "hold"
      },
      "clears_on_profile_switch": true,
      "overrides": [
        {
          "id": "base.l1.left_stick.select_mode",
          "input": { "device": "ds4", "control": "left_stick" },
          "target": { "type": "mouse_move", "axis": "both" },
          "analog": { "deadzone": 0.15, "sensitivity": 0.8, "curve": "linear" }
        },
        {
          "id": "base.l1.right_stick.secondary_zoom",
          "input": { "device": "ds4", "control": "right_stick" },
          "target": { "type": "catia_camera", "operation": "zoom" },
          "analog": { "deadzone": 0.12, "sensitivity": 0.9, "curve": "ease_out_cubic" }
        },
        {
          "id": "base.l1.cross.add_to_selection",
          "input": { "device": "ds4", "control": "cross" },
          "target": { "type": "catia_selection", "operation": "add" }
        },
        {
          "id": "base.l1.prev_profile",
          "input": { "device": "ds4", "control": "share" },
          "target": { "type": "app_control", "action": "prev_profile" }
        }
      ]
    }
  ]
}
